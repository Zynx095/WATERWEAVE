{
  "name": "waterweave-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Web frontend and guided presentation for WATERWEAVE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
